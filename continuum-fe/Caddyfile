# Production front door (see Dockerfile). Set in the environment:
#   DOMAIN       the public host name, e.g. continuum.duckdns.org — Caddy gets
#                and renews its HTTPS certificate automatically. "localhost"
#                serves with a local, self-signed certificate (for a test run).
#   ACME_EMAIL   where Let's Encrypt sends expiry notices.
#   API_UPSTREAM the backend inside the compose network (default api:8000).
{
	email {$ACME_EMAIL:admin@example.com}
}

{$DOMAIN:localhost} {
	encode zstd gzip

	# The API. Caddy sets X-Real-IP to the real visitor, overwriting anything a
	# client sent — which is what makes TRUST_PROXY_HEADERS=true safe, so the
	# sign-in lockout counts visitors rather than this proxy.
	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:8000} {
			header_up X-Real-IP {remote_host}
			# Chat answers stream as server-sent events: pass each chunk on now.
			flush_interval -1
		}
	}

	# The app. Unknown paths serve index.html, so a reload on any screen works.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server

		# Hashed bundles never change: cache them for a year. index.html must
		# not be cached, or a deploy would keep serving the old bundle names.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@index path / /index.html
		header @index Cache-Control "no-cache"
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		# The microphone is used for dictation and Lumen, on this origin only.
		Permissions-Policy "microphone=(self), camera=(), geolocation=()"
		-Server
	}
}
