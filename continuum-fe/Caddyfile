# Production front door (see Dockerfile). Set in the environment:
#   DOMAIN       the public host name, e.g. continuum.duckdns.org — Caddy gets
#                and renews its HTTPS certificate automatically. "localhost"
#                serves with a local, self-signed certificate (for a test run).
#   ACME_EMAIL   where Let's Encrypt sends expiry notices.
#   API_UPSTREAM the backend inside the compose network (default api:8000).
{
	email {$ACME_EMAIL:admin@example.com}
}

{$DOMAIN:localhost} {
	encode zstd gzip

	# The API. Caddy sets X-Real-IP to the real visitor, overwriting anything a
	# client sent — which is what makes TRUST_PROXY_HEADERS=true safe, so the
	# sign-in lockout counts visitors rather than this proxy.
	handle /api/* {
		# Refused here, before it reaches the API. The API has its own limit
		# (MAX_REQUEST_BYTES; dictated audio gets SPEECH_MAX_BYTES + 1 MB): this
		# one stops an oversized body at the edge, before it is even forwarded.
		request_body {
			max_size 12MB
		}
		reverse_proxy {$API_UPSTREAM:api:8000} {
			header_up X-Real-IP {remote_host}
			# Chat answers stream as server-sent events: pass each chunk on now.
			flush_interval -1
		}
	}

	# The app. Unknown paths serve index.html, so a reload on any screen works.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server

		# Hashed bundles never change: cache them for a year. index.html must
		# not be cached, or a deploy would keep serving the old bundle names.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@index path / /index.html
		header @index Cache-Control "no-cache"
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		# The microphone is used for dictation and Lumen, on this origin only.
		Permissions-Policy "microphone=(self), camera=(), geolocation=()"
		# Only this origin's own scripts run — no inline script, no eval — so an
		# answer rendered from model output can never carry code in with it.
		# Inline styles stay: libraries set them, and they cannot run anything.
		# Checked against the built app in a browser: no violations, the graph,
		# Lumen and the sign-in page all draw.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}
}
