# --- App ---------------------------------------------------------------
APP_NAME=Continuum
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=line      # or json: one object per line, for a log aggregator
LOG_COLORS=true
API_PREFIX=/api/v1

# --- Postgres (accounts, sessions, API keys) ----------------------------
# Memories stay in Qdrant; Postgres holds only the account store. The schema is
# managed by Alembic and upgraded automatically when the API starts.
#
# For a local `uv run` API, against the compose Postgres on localhost:
DATABASE_URL=postgresql+asyncpg://continuum:continuum@localhost:5432/continuum
# DATABASE_POOL_SIZE=5          # per API process; keep workers x (pool + overflow)
# DATABASE_MAX_OVERFLOW=5       # under Postgres's max_connections
#
# (The Docker stack does not read this file: its settings are in
# continuum-be/.envs/.local/ — see continuum-be/local.yml.)

# --- Dictation (speech to text) -----------------------------------------
# Local Whisper via faster-whisper. The model downloads once on first start.
# SPEECH_ENABLED=true
# SPEECH_MODEL=base            # tiny | base | small | medium: accuracy vs speed
# SPEECH_LANGUAGE=en           # blank = detect per recording
# SPEECH_MAX_SECONDS=120
# SPEECH_DEVICE=cpu            # cuda with an NVIDIA GPU
HF_HUB_DISABLE_TELEMETRY=1

# --- Authentication ----------------------------------------------------
# Every request needs a credential: the web UI signs in (session cookie), agents
# send `Authorization: Bearer ck_...` with a key created in Account -> API keys.
# The memory owner is whoever the credential belongs to; no request can name one.
#
# First admin. Leave unset and the web UI offers "create the admin account" on
# first visit. On an instance strangers can reach, set these instead and turn
# web setup off — otherwise whoever loads the page first owns it.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=a-long-passphrase
# ADMIN_USER_ID=mark            # adopt memories stored before auth existed
# AUTH_ALLOW_WEB_SETUP=true
#
# SESSION_TTL_HOURS=336                 # 14 days, absolute
# SESSION_COOKIE_SECURE=                # blank = Secure whenever served over HTTPS
# PASSWORD_MIN_LENGTH=10
# LOGIN_MAX_FAILURES=5                  # per email and per client address...
# LOGIN_LOCKOUT_MINUTES=15              # ...within this window
# TRUST_PROXY_HEADERS=false             # only behind a proxy that sets X-Real-IP
#
# Abuse limits
# LLM_REQUESTS_PER_MINUTE=30            # per user: ingest, chat, search, preview
# MAX_INPUT_CHARS=50000                 # largest note or chat transcript accepted

# --- Qdrant ------------------------------------------------------------
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=continuum_memories

# --- LLM (any OpenAI-compatible endpoint) ------------------------------
# Ollama (default, fully local):
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b-instruct
#
# Groq (fast hosted open-weights):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile
#
# vLLM (self-hosted, production):
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_API_KEY=EMPTY
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1536

# --- Ollama -------------------------------------------------------------
# docker compose uses the Ollama running on your HOST, not a container — a
# containerised Ollama duplicated every model (5.5 GB image + 6.1 GB of models).
# The containers reach it as host.docker.internal. Override to use another one.
# OLLAMA_URL=http://host.docker.internal:11434
#
# (The LLM_BASE_URL / EMBEDDING_BASE_URL below are for a local `uvicorn` run,
# which talks to Ollama directly on localhost.)

# --- Embeddings --------------------------------------------------------
# bge-m3 is the default since Phase 5. nomic-embed-text, the old default,
# returns BYTE-IDENTICAL vectors for sentences that differ only by a name
# ("Atlas stores events in Postgres" / "... in MongoDB" score 1.0000), so
# retrieval cannot tell those entities apart (FINDINGS §1).
#
# Before trusting a model:
#     uv run python scripts/run_eval.py --preflight     # can it see a swap?
#     uv run python scripts/run_eval.py --calibrate     # which thresholds?
#
# Switching model is safe and needs no manual step: each model gets its own
# collection, and on startup the api re-embeds every memory from the previously
# active one. Nothing is deleted; switching back works.
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# --- Memory policy -----------------------------------------------------
DEFAULT_CONFIDENCE=0.70
# The two cosine bands belong to the EMBEDDING MODEL, not the product. Leave
# them unset and they come from the calibration table in config.py for the
# configured model (bge-m3: 0.86 / 0.45). Set them only to override, and if you
# add a model, derive its pair with `run_eval.py --calibrate`.
# DUPLICATE_SIMILARITY_THRESHOLD=
# CONFLICT_SIMILARITY_THRESHOLD=
RETRIEVAL_TOP_K=8

# --- Resolution policy (Phase 2) ---------------------------------------
# How sure the judge must be before a memory is retired WITHOUT asking you.
# Below this, a "supersedes" verdict is downgraded to a human escalation.
# The most consequential setting in the system: raise it to escalate more,
# lower it to silently lose more beliefs.
AUTO_SUPERSEDE_CONFIDENCE=0.80
# A `person` memory is retired only when the new statement says the earlier
# arrangement ended ("now", "no longer", "has taken over"). A bare second name
# for a role that is usually shared is escalated instead (FINDINGS §10).
# PERSON_SUPERSEDE_REQUIRES_CHANGE_LANGUAGE=true
SUPERSEDED_WINNER_CONFIDENCE=0.85
REINFORCEMENT_STEP=0.05
RESOLUTION_CANDIDATE_LIMIT=5

# --- Decay policy (Phase 2) --------------------------------------------
DECAY_ENABLED=true
DECAY_INTERVAL_MINUTES=360
DECAY_ARCHIVE_THRESHOLD=0.25
DECAY_FLOOR=0.05
DECAY_BATCH_LIMIT=2000

# --- Chat & retrieval (Phase 3) ----------------------------------------
CHAT_MEMORY_LIMIT=6
CHAT_CANDIDATE_MULTIPLIER=4
CHAT_MIN_SIMILARITY=0.35
CHAT_MAX_HISTORY=12
CHAT_TEMPERATURE=0.3
# Run each chat turn back through ingest, so a conversation confirms existing
# memories and records new ones. Set false to make chat read-only.
CHAT_REMEMBER_TURNS=true

# Retrieval rank = similarity x confidence^w_conf x recency^w_rec.
# Set a weight to 0 to disable that factor outright (useful for A/B evaluation).
RETRIEVAL_CONFIDENCE_WEIGHT=1.0
RETRIEVAL_RECENCY_WEIGHT=1.0
# Not the per-category decay half-life: decay asks "do we still believe this",
# recency asks "is this topical now".
RETRIEVAL_RECENCY_HALF_LIFE_DAYS=45
# Age down-ranks a memory; it never makes one unreachable.
RETRIEVAL_RECENCY_FLOOR=0.30

# --- Frontend (Phase 4) ------------------------------------------------
# The UI runs on the Vite dev server (`yarn dev` in continuum-fe/), not Docker.
# Where it proxies /api to (default http://localhost:8000):
# VITE_API_PROXY=http://localhost:8000
# Avoid VITE_API_URL (calling the API cross-origin): the session cookie is
# SameSite=Strict and cookie writes need CORS, so sign-in only works same-origin.
