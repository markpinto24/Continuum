# --- App ---------------------------------------------------------------
APP_NAME=Continuum
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# --- Qdrant ------------------------------------------------------------
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=continuum_memories

# --- LLM (any OpenAI-compatible endpoint) ------------------------------
# Ollama (default, fully local):
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b-instruct
#
# Groq (fast hosted open-weights):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile
#
# vLLM (self-hosted, production):
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_API_KEY=EMPTY
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1536

# --- Ollama -------------------------------------------------------------
# docker compose uses the Ollama running on your HOST, not a container — a
# containerised Ollama duplicated every model (5.5 GB image + 6.1 GB of models).
# The containers reach it as host.docker.internal. Override to use another one.
# OLLAMA_URL=http://host.docker.internal:11434
#
# (The LLM_BASE_URL / EMBEDDING_BASE_URL below are for a local `uvicorn` run,
# which talks to Ollama directly on localhost.)

# --- Embeddings --------------------------------------------------------
# bge-m3 is the default since Phase 5. nomic-embed-text, the old default,
# returns BYTE-IDENTICAL vectors for sentences that differ only by a name
# ("Atlas stores events in Postgres" / "... in MongoDB" score 1.0000), so
# retrieval cannot tell those entities apart (FINDINGS §1).
#
# Before trusting a model:
#     uv run python scripts/run_eval.py --preflight     # can it see a swap?
#     uv run python scripts/run_eval.py --calibrate     # which thresholds?
#
# Switching model is safe and needs no manual step: each model gets its own
# collection, and on startup the api re-embeds every memory from the previously
# active one. Nothing is deleted; switching back works.
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# --- Memory policy -----------------------------------------------------
DEFAULT_CONFIDENCE=0.70
# The two cosine bands belong to the EMBEDDING MODEL, not the product. Leave
# them unset and they come from the calibration table in config.py for the
# configured model (bge-m3: 0.86 / 0.45). Set them only to override, and if you
# add a model, derive its pair with `run_eval.py --calibrate`.
# DUPLICATE_SIMILARITY_THRESHOLD=
# CONFLICT_SIMILARITY_THRESHOLD=
RETRIEVAL_TOP_K=8

# --- Resolution policy (Phase 2) ---------------------------------------
# How sure the judge must be before a memory is retired WITHOUT asking you.
# Below this, a "supersedes" verdict is downgraded to a human escalation.
# The most consequential setting in the system: raise it to escalate more,
# lower it to silently lose more beliefs.
AUTO_SUPERSEDE_CONFIDENCE=0.80
# A `person` memory is retired only when the new statement says the earlier
# arrangement ended ("now", "no longer", "has taken over"). A bare second name
# for a role that is usually shared is escalated instead (FINDINGS §10).
# PERSON_SUPERSEDE_REQUIRES_CHANGE_LANGUAGE=true
SUPERSEDED_WINNER_CONFIDENCE=0.85
REINFORCEMENT_STEP=0.05
RESOLUTION_CANDIDATE_LIMIT=5

# --- Decay policy (Phase 2) --------------------------------------------
DECAY_ENABLED=true
DECAY_INTERVAL_MINUTES=360
DECAY_ARCHIVE_THRESHOLD=0.25
DECAY_FLOOR=0.05
DECAY_BATCH_LIMIT=2000

# --- Chat & retrieval (Phase 3) ----------------------------------------
CHAT_MEMORY_LIMIT=6
CHAT_CANDIDATE_MULTIPLIER=4
CHAT_MIN_SIMILARITY=0.35
CHAT_MAX_HISTORY=12
CHAT_TEMPERATURE=0.3
# Run each chat turn back through ingest, so a conversation confirms existing
# memories and records new ones. Set false to make chat read-only.
CHAT_REMEMBER_TURNS=true

# Retrieval rank = similarity x confidence^w_conf x recency^w_rec.
# Set a weight to 0 to disable that factor outright (useful for A/B evaluation).
RETRIEVAL_CONFIDENCE_WEIGHT=1.0
RETRIEVAL_RECENCY_WEIGHT=1.0
# Not the per-category decay half-life: decay asks "do we still believe this",
# recency asks "is this topical now".
RETRIEVAL_RECENCY_HALF_LIFE_DAYS=45
# Age down-ranks a memory; it never makes one unreachable.
RETRIEVAL_RECENCY_FLOOR=0.30

# --- Frontend (Phase 4) ------------------------------------------------
# Only needed for `npm run dev`. In Docker the bundle calls same-origin /api
# and nginx proxies it to the api service, so neither of these is set — Vite
# inlines env vars at BUILD time, so an absolute URL baked into the image
# could not be overridden at run time anyway.
#
# Where `npm run dev` proxies /api to (default http://localhost:8000):
# VITE_API_PROXY=http://localhost:8000
# Or call an absolute origin directly, bypassing the proxy:
# VITE_API_URL=http://localhost:8000
